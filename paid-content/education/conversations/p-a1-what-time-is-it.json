{"topic":"What Time Is It?","scenarios":[{"scenario":"What time is it?","context":"A child asks the time.","speakerA":[{"en":"Mom, what time is it?","level":"A1"},{"en":"Is it morning?","level":"A1"},{"en":"I'm hungry.","level":"A1"}],"speakerB":[{"en":"It's seven o'clock.","level":"A1"},{"en":"Yes. Time to get up.","level":"A1"},{"en":"Let's eat breakfast.","level":"A1"}]},{"scenario":"Lunch time","context":"A child asks about lunch.","speakerA":[{"en":"Is it lunch time?","level":"A1"},{"en":"I'm hungry.","level":"A1"},{"en":"OK. What's for lunch?","level":"A1"}],"speakerB":[{"en":"Yes, it's twelve o'clock.","level":"A1"},{"en":"Wash your hands first.","level":"A1"},{"en":"Rice and chicken.","level":"A1"}]},{"scenario":"School time","context":"Parent and child get ready.","speakerA":[{"en":"What time is school?","level":"A1"},{"en":"Is it late?","level":"A1"},{"en":"Let's go now.","level":"A1"}],"speakerB":[{"en":"School is at eight o'clock.","level":"A1"},{"en":"No, we have time.","level":"A1"},{"en":"OK. I have my bag.","level":"A1"}]},{"scenario":"Playtime","context":"A child wants to play.","speakerA":[{"en":"Can I play now?","level":"A1"},{"en":"How long can I play?","level":"A1"},{"en":"Thank you, Dad!","level":"A1"}],"speakerB":[{"en":"It's four o'clock. Yes.","level":"A1"},{"en":"One hour.","level":"A1"},{"en":"Be home at five.","level":"A1"}]},{"scenario":"Good night","context":"Night time comes.","speakerA":[{"en":"It's night. The moon is out.","level":"A1"},{"en":"Yes. It's eight o'clock.","level":"A1"},{"en":"No. Good night.","level":"A1"}],"speakerB":[{"en":"Is it bedtime?","level":"A1"},{"en":"Can I stay up?","level":"A1"},{"en":"Good night, Dad.","level":"A1"}]}]}
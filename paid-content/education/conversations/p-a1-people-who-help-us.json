{"topic":"People Who Help Us","scenarios":[{"scenario":"At the doctor","context":"A child visits the doctor.","speakerA":[{"en":"Hello. How are you?","level":"A1"},{"en":"Let me look. Open your mouth.","level":"A1"},{"en":"You are OK. Drink water and rest.","level":"A1"}],"speakerB":[{"en":"I'm not well. My head hurts.","level":"A1"},{"en":"Aaah.","level":"A1"},{"en":"Thank you, doctor.","level":"A1"}]},{"scenario":"The police officer","context":"A child is lost.","speakerA":[{"en":"Excuse me. I'm lost.","level":"A1"},{"en":"My name is Sam.","level":"A1"},{"en":"I don't know.","level":"A1"}],"speakerB":[{"en":"Don't be scared. What's your name?","level":"A1"},{"en":"Where is your mom?","level":"A1"},{"en":"Let's find her together.","level":"A1"}]},{"scenario":"The baker","context":"A child buys bread.","speakerA":[{"en":"Hello. Can I have some bread?","level":"A1"},{"en":"How much is it?","level":"A1"},{"en":"Here you are.","level":"A1"}],"speakerB":[{"en":"Yes. Here is fresh bread.","level":"A1"},{"en":"It's one dollar.","level":"A1"},{"en":"Thank you. Have a nice day!","level":"A1"}]},{"scenario":"The firefighter","context":"Children visit the fire station.","speakerA":[{"en":"Look! A fire truck!","level":"A1"},{"en":"Are you a firefighter?","level":"A1"},{"en":"Can I see the truck?","level":"A1"}],"speakerB":[{"en":"Yes. It's big and red.","level":"A1"},{"en":"Yes, I am. I help people.","level":"A1"},{"en":"Yes, you can. Come with me.","level":"A1"}]},{"scenario":"The bus driver","context":"A child thanks the driver.","speakerA":[{"en":"Good morning, driver.","level":"A1"},{"en":"I'm fine, thank you.","level":"A1"},{"en":"Thank you for the ride.","level":"A1"}],"speakerB":[{"en":"Good morning! How are you?","level":"A1"},{"en":"Sit down, please.","level":"A1"},{"en":"You're welcome. See you tomorrow!","level":"A1"}]}]}
{"topic":"At the Beach","scenarios":[{"scenario":"Look at the sea","context":"A family arrives at the beach.","speakerA":[{"en":"Look, Dad! The sea!","level":"A1"},{"en":"Can I go in the water?","level":"A1"},{"en":"The water is cold.","level":"A1"}],"speakerB":[{"en":"It's big and blue.","level":"A1"},{"en":"Yes, but hold my hand.","level":"A1"},{"en":"Don't worry. You can swim with me.","level":"A1"}]},{"scenario":"Playing in the sand","context":"Two children play.","speakerA":[{"en":"Let's play in the sand.","level":"A1"},{"en":"Let's make a castle.","level":"A1"},{"en":"Look! It's big.","level":"A1"}],"speakerB":[{"en":"OK. I have a bucket.","level":"A1"},{"en":"Good idea. I can dig.","level":"A1"},{"en":"It's great! I love it.","level":"A1"}]},{"scenario":"I see a crab","context":"A child finds a crab.","speakerA":[{"en":"Look! I see a crab.","level":"A1"},{"en":"Here, near the rock.","level":"A1"},{"en":"It's small. It can walk fast.","level":"A1"}],"speakerB":[{"en":"Where is it?","level":"A1"},{"en":"Don't touch it.","level":"A1"},{"en":"Yes. It's going into the water.","level":"A1"}]},{"scenario":"The sun is hot","context":"A parent puts on sun cream.","speakerA":[{"en":"The sun is very hot today.","level":"A1"},{"en":"Put on your hat, please.","level":"A1"},{"en":"It's in the bag.","level":"A1"}],"speakerB":[{"en":"I'm hot, Mom.","level":"A1"},{"en":"OK. Where is my hat?","level":"A1"},{"en":"Thank you. Now I'm OK.","level":"A1"}]},{"scenario":"An ice cream, please","context":"A child buys ice cream.","speakerA":[{"en":"Hello. An ice cream, please.","level":"A1"},{"en":"I want pink, please.","level":"A1"},{"en":"How much is it?","level":"A1"}],"speakerB":[{"en":"What color do you want?","level":"A1"},{"en":"Here you are.","level":"A1"},{"en":"It's two dollars. Thank you.","level":"A1"}]}]}
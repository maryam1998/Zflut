{"topic":"On the Farm","scenarios":[{"scenario":"Farm animals","context":"A child visits a farm.","speakerA":[{"en":"Look at the farm!","level":"A1"},{"en":"What do cows give us?","level":"A1"},{"en":"I see sheep too.","level":"A1"}],"speakerB":[{"en":"I see a cow and a horse.","level":"A1"},{"en":"They give us milk.","level":"A1"},{"en":"Yes. Sheep give us wool.","level":"A1"}]},{"scenario":"Baby animals","context":"Children see baby animals.","speakerA":[{"en":"Look! A baby chick.","level":"A1"},{"en":"I see a lamb.","level":"A1"},{"en":"And a calf!","level":"A1"}],"speakerB":[{"en":"It's yellow and small.","level":"A1"},{"en":"It's soft and white.","level":"A1"},{"en":"A calf is a baby cow.","level":"A1"}]},{"scenario":"The chicken","context":"A farmer shows eggs.","speakerA":[{"en":"Hello, farmer.","level":"A1"},{"en":"Yes, please.","level":"A1"},{"en":"Can I touch them?","level":"A1"}],"speakerB":[{"en":"Hello! Do you want to see the chickens?","level":"A1"},{"en":"Here are some eggs.","level":"A1"},{"en":"Yes, be careful.","level":"A1"}]},{"scenario":"Feed the animals","context":"A child helps the farmer.","speakerA":[{"en":"Can I feed the horse?","level":"A1"},{"en":"The horse is eating.","level":"A1"},{"en":"He likes me!","level":"A1"}],"speakerB":[{"en":"Yes. Here is some grass.","level":"A1"},{"en":"He is hungry.","level":"A1"},{"en":"Good job.","level":"A1"}]},{"scenario":"Time to go","context":"The farm visit ends.","speakerA":[{"en":"Time to go home.","level":"A1"},{"en":"Yes, come back soon.","level":"A1"},{"en":"They say goodbye too.","level":"A1"}],"speakerB":[{"en":"Can I come again?","level":"A1"},{"en":"Goodbye, cow! Goodbye, horse!","level":"A1"},{"en":"Thank you, farmer.","level":"A1"}]}]}
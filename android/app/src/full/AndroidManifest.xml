<?xml version="1.0" encoding="utf-8"?>
<!-- نسخه‌ی «full»: فقط سرویس Accessibility (راهِ جایگزینِ تغییر سرعتِ یوتیوب) اینجاست.
     نسخه‌ی «store» این را ندارد. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>

        <!-- ⏩ سرعتِ پخشِ یوتیوب از منوی خودش (فقط com.google.android.youtube؛ کاربر باید دستی روشنش کنه) -->
        <service
            android:name=".overlay.SpeedAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>

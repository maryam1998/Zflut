{"topic":"Making Friends","scenarios":[{"scenario":"Do you want to play?","context":"A child meets a new child.","speakerA":[{"en":"Hello. I'm Mia.","level":"A1"},{"en":"Do you want to play?","level":"A1"},{"en":"Let's play with the ball.","level":"A1"}],"speakerB":[{"en":"Hi, Mia. I'm Ben.","level":"A1"},{"en":"Yes, please. What can we play?","level":"A1"},{"en":"OK! Let's go.","level":"A1"}]},{"scenario":"You are my friend","context":"Two children become friends.","speakerA":[{"en":"Ben, you are my friend.","level":"A1"},{"en":"I like your toy.","level":"A1"},{"en":"Really? Thank you!","level":"A1"}],"speakerB":[{"en":"You are my friend too.","level":"A1"},{"en":"Thank you. You can play with it.","level":"A1"},{"en":"You're welcome. We can share.","level":"A1"}]},{"scenario":"I'm new here","context":"A new child is shy.","speakerA":[{"en":"Hello. I'm new here.","level":"A1"},{"en":"My name is Leo.","level":"A1"},{"en":"Can I sit with you?","level":"A1"}],"speakerB":[{"en":"Welcome! What's your name?","level":"A1"},{"en":"Nice to meet you, Leo. I'm Sara.","level":"A1"},{"en":"Yes, you can. Come here.","level":"A1"}]},{"scenario":"Are you sad?","context":"A child sees a sad friend.","speakerA":[{"en":"Are you sad?","level":"A1"},{"en":"Why are you sad?","level":"A1"},{"en":"Let's look for it together.","level":"A1"}],"speakerB":[{"en":"Yes, I am.","level":"A1"},{"en":"I can't find my ball.","level":"A1"},{"en":"Thank you. You are a good friend.","level":"A1"}]},{"scenario":"See you tomorrow","context":"Friends say goodbye.","speakerA":[{"en":"It's time to go home.","level":"A1"},{"en":"Bye, Ben. Have a nice day!","level":"A1"},{"en":"Yes! Let's play at the park.","level":"A1"}],"speakerB":[{"en":"Bye, Mia. See you tomorrow!","level":"A1"},{"en":"Can we play again?","level":"A1"},{"en":"Great. Goodbye!","level":"A1"}]}]}
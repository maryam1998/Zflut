{"topic":"Seasons and Clothes","scenarios":[{"scenario":"It's cold today","context":"A parent helps a child dress for winter.","speakerA":[{"en":"It's cold today.","level":"A1"},{"en":"Wear your coat and hat.","level":"A1"},{"en":"They are in your bag.","level":"A1"}],"speakerB":[{"en":"What can I wear?","level":"A1"},{"en":"Where are my gloves?","level":"A1"},{"en":"Thank you, Mom.","level":"A1"}]},{"scenario":"Summer time","context":"A child dresses for summer.","speakerA":[{"en":"It's hot today.","level":"A1"},{"en":"Can I wear my sandals?","level":"A1"},{"en":"Where is my cap?","level":"A1"}],"speakerB":[{"en":"Put on your shorts and T-shirt.","level":"A1"},{"en":"Yes, you can.","level":"A1"},{"en":"It's on the chair.","level":"A1"}]},{"scenario":"It's raining","context":"A child gets ready for rain.","speakerA":[{"en":"Look! It's raining.","level":"A1"},{"en":"Can I wear my boots?","level":"A1"},{"en":"I'm ready!","level":"A1"}],"speakerB":[{"en":"Take your umbrella.","level":"A1"},{"en":"Yes. Put on your coat too.","level":"A1"},{"en":"Be careful. Don't run.","level":"A1"}]},{"scenario":"My favorite season","context":"Two friends talk about seasons.","speakerA":[{"en":"What's your favorite season?","level":"A1"},{"en":"I like winter. I love snow.","level":"A1"},{"en":"Yes, I do. We make a snowman.","level":"A1"}],"speakerB":[{"en":"I like summer. It's warm.","level":"A1"},{"en":"Do you play in the snow?","level":"A1"},{"en":"That sounds fun!","level":"A1"}]},{"scenario":"Spring flowers","context":"Children see flowers.","speakerA":[{"en":"It's spring! Look at the flowers.","level":"A1"},{"en":"I like the pink flowers.","level":"A1"},{"en":"Yes, it's warm and sunny.","level":"A1"}],"speakerB":[{"en":"They are pink and yellow.","level":"A1"},{"en":"The sun is out today.","level":"A1"},{"en":"I love spring.","level":"A1"}]}]}
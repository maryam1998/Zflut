{"topic":"Big and Small","scenarios":[{"scenario":"Big or small?","context":"Two children look at animals.","speakerA":[{"en":"Look at the elephant. It's big.","level":"A1"},{"en":"Is the cat big or small?","level":"A1"},{"en":"The horse is bigger than the dog.","level":"A1"}],"speakerB":[{"en":"Yes. And the mouse is small.","level":"A1"},{"en":"It's small. The dog is bigger.","level":"A1"},{"en":"Yes. It's very big.","level":"A1"}]},{"scenario":"Long and short","context":"Two children compare pencils.","speakerA":[{"en":"My pencil is long.","level":"A1"},{"en":"Can I see?","level":"A1"},{"en":"Yours is longer.","level":"A1"}],"speakerB":[{"en":"My pencil is short.","level":"A1"},{"en":"Here you are.","level":"A1"},{"en":"Yes. Mine is new.","level":"A1"}]},{"scenario":"Fast and slow","context":"Children watch animals run.","speakerA":[{"en":"The rabbit is fast.","level":"A1"},{"en":"I can run fast.","level":"A1"},{"en":"Yes, I can. Look!","level":"A1"}],"speakerB":[{"en":"The turtle is slow.","level":"A1"},{"en":"Can you walk slowly?","level":"A1"},{"en":"Good job!","level":"A1"}]},{"scenario":"Hot and cold","context":"A child touches a cup.","speakerA":[{"en":"Be careful. The tea is hot.","level":"A1"},{"en":"The water is cold.","level":"A1"},{"en":"Yes. It's not hot. It's warm.","level":"A1"}],"speakerB":[{"en":"And the water?","level":"A1"},{"en":"Can I have warm milk?","level":"A1"},{"en":"Thank you.","level":"A1"}]},{"scenario":"Old and new","context":"Two children compare shoes.","speakerA":[{"en":"I have new shoes.","level":"A1"},{"en":"Your shoes are old.","level":"A1"},{"en":"They are still good.","level":"A1"}],"speakerB":[{"en":"They are nice!","level":"A1"},{"en":"Yes, my shoes are old.","level":"A1"},{"en":"Yes. I like them.","level":"A1"}]}]}
{"topic":"Art Time","scenarios":[{"scenario":"I want to draw","context":"A child starts to draw.","speakerA":[{"en":"Teacher, I want to draw.","level":"A1"},{"en":"Can I have a pencil?","level":"A1"},{"en":"What can I draw?","level":"A1"}],"speakerB":[{"en":"Good! Here is paper.","level":"A1"},{"en":"Yes. Here you are.","level":"A1"},{"en":"Draw your family.","level":"A1"}]},{"scenario":"What color is it?","context":"Children paint a picture.","speakerA":[{"en":"I have red, blue and yellow.","level":"A1"},{"en":"What color is the sun?","level":"A1"},{"en":"Can I have the yellow paint?","level":"A1"}],"speakerB":[{"en":"I want blue for the sky.","level":"A1"},{"en":"The sun is yellow.","level":"A1"},{"en":"Yes, here you are.","level":"A1"}]},{"scenario":"It's beautiful!","context":"A child shows a picture.","speakerA":[{"en":"Look at my picture!","level":"A1"},{"en":"It's my house.","level":"A1"},{"en":"Yes! The cat is orange.","level":"A1"}],"speakerB":[{"en":"It's beautiful! What is it?","level":"A1"},{"en":"I see a tree and a cat.","level":"A1"},{"en":"I love it. Good job!","level":"A1"}]},{"scenario":"I need scissors","context":"A child needs a tool.","speakerA":[{"en":"Excuse me. I need scissors.","level":"A1"},{"en":"Thank you. Where is the glue?","level":"A1"},{"en":"I can cut the paper.","level":"A1"}],"speakerB":[{"en":"Here you are. Be careful.","level":"A1"},{"en":"It's on the table.","level":"A1"},{"en":"Great! Then glue it.","level":"A1"}]},{"scenario":"Clean up","context":"Art time is over.","speakerA":[{"en":"Time to clean up.","level":"A1"},{"en":"You can finish tomorrow.","level":"A1"},{"en":"Put them in the box.","level":"A1"}],"speakerB":[{"en":"I'm not done.","level":"A1"},{"en":"OK. Where are the crayons?","level":"A1"},{"en":"Done! Can I wash my hands?","level":"A1"}]}]}
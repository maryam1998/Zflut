{"topic":"On the School Bus","scenarios":[{"scenario":"Is this the school bus?","context":"A child gets on the bus.","speakerA":[{"en":"Good morning. Is this the school bus?","level":"A1"},{"en":"Thank you. Where can I sit?","level":"A1"},{"en":"Is it OK?","level":"A1"}],"speakerB":[{"en":"Yes, it is. Get on, please.","level":"A1"},{"en":"You can sit here.","level":"A1"},{"en":"Yes. Sit down and be careful.","level":"A1"}]},{"scenario":"Where is my bag?","context":"A child looks for a bag.","speakerA":[{"en":"Where is my bag?","level":"A1"},{"en":"No, it isn't.","level":"A1"},{"en":"Oh, here it is!","level":"A1"}],"speakerB":[{"en":"Is it under your seat?","level":"A1"},{"en":"Look behind you.","level":"A1"},{"en":"Good. Put it on your legs.","level":"A1"}]},{"scenario":"Look at the car","context":"Two friends look outside.","speakerA":[{"en":"Look! A big red car.","level":"A1"},{"en":"I see a bus too.","level":"A1"},{"en":"It's next to the truck.","level":"A1"}],"speakerB":[{"en":"I see it. It's fast.","level":"A1"},{"en":"Where is the bus?","level":"A1"},{"en":"Yes! I see it.","level":"A1"}]},{"scenario":"Stop, please","context":"The bus arrives at school.","speakerA":[{"en":"We are at school.","level":"A1"},{"en":"Can I go now?","level":"A1"},{"en":"OK. Now?","level":"A1"}],"speakerB":[{"en":"Stand up, please.","level":"A1"},{"en":"Not yet. Wait for the bus to stop.","level":"A1"},{"en":"Yes. Go slowly. Goodbye!","level":"A1"}]},{"scenario":"Be quiet","context":"The driver asks for quiet.","speakerA":[{"en":"Please be quiet, children.","level":"A1"},{"en":"Don't stand up.","level":"A1"},{"en":"Thank you. You are good children.","level":"A1"}],"speakerB":[{"en":"Sorry, driver.","level":"A1"},{"en":"OK. I'm sitting.","level":"A1"},{"en":"Thank you, driver.","level":"A1"}]}]}
[{"id":200000,"level":"A1","pos":"other","en":"routine","fa":"روال، برنامه‌ی منظم","example":"It's a good idea to have a routine when you study.","collocation":"daily/weekly routine","category":"یادگیری لغت"},{"id":200001,"level":"A1","pos":"other","en":"at least","fa":"حداقل","example":"Study a new unit for at least 30–45 minutes.","collocation":"at least + number/time","category":"یادگیری لغت"},{"id":200002,"level":"A1","pos":"other","en":"revise","fa":"مرور کردن، دوباره خواندن","example":"You may only need to revise for five or ten minutes.","collocation":"revise a unit / revise for an exam","category":"یادگیری لغت"},{"id":200003,"level":"A1","pos":"other","en":"aloud","fa":"بلند (با صدا)","example":"With a new word, say it aloud and repeat it.","collocation":"say it aloud","category":"یادگیری لغت"},{"id":200004,"level":"A1","pos":"other","en":"silently","fa":"بی‌صدا، در ذهن","example":"Repeat it to yourself silently.","collocation":"repeat silently","category":"یادگیری لغت"},{"id":200005,"level":"A1","pos":"other","en":"highlighter pen","fa":"ماژیک هایلایت","example":"Use a highlighter pen to mark important words.","collocation":"use a highlighter pen","category":"یادگیری لغت"},{"id":200006,"level":"A1","pos":"other","en":"rub out","fa":"پاک کردن (با پاک‌کن)","example":"Do exercises in pencil, then you can rub them out.","collocation":"rub out a mistake","category":"یادگیری لغت"},{"id":200007,"level":"A1","pos":"other","en":"rubber","fa":"پاک‌کن","example":"You need a rubber to rub out pencil marks.","collocation":"use a rubber","category":"یادگیری لغت"},{"id":200008,"level":"A1","pos":"other","en":"example sentence","fa":"جمله‌ی مثال","example":"Always try to write an example sentence for new words.","collocation":"write an example sentence","category":"یادگیری لغت"},{"id":200009,"level":"A1","pos":"other","en":"expand","fa":"گسترش دادن، بزرگ‌تر کردن","example":"Building word families will help expand your vocabulary.","collocation":"expand your vocabulary","category":"یادگیری لغت"},{"id":200010,"level":"A1","pos":"other","en":"synonym","fa":"مترادف","example":"Think of synonyms for the word 'dirty'.","collocation":"a synonym for ...","category":"یادگیری لغت"},{"id":200011,"level":"A1","pos":"other","en":"opposite","fa":"متضاد","example":"The opposite of 'dirty' is 'clean'.","collocation":"the opposite of ...","category":"یادگیری لغت"},{"id":200012,"level":"A1","pos":"other","en":"word family","fa":"خانواده‌ی واژه","example":"From a noun, verb or adjective, you can find related words.","collocation":"build word families","category":"یادگیری لغت"},{"id":200013,"level":"A1","pos":"other","en":"argument","fa":"بحث، جر و بحث","example":"Argue means have an angry discussion; noun = argument.","collocation":"have an argument","category":"یادگیری لغت"},{"id":200014,"level":"A1","pos":"other","en":"collocation","fa":"هم‌نشینی واژگانی","example":"Words that commonly go together are called collocations.","collocation":"common collocations","category":"یادگیری لغت"},{"id":200015,"level":"A1","pos":"other","en":"register","fa":"سبک (رسمی/غیررسمی)","example":"Check if the word is particularly formal or informal.","collocation":"formal/informal register","category":"یادگیری لغت"},{"id":200016,"level":"A2","pos":"other","en":"notebook","fa":"دفترچه یادداشت","example":"Write down new English words in your notebook.","collocation":"keep a notebook","category":"داشتن دفترچه‌ی لغت"},{"id":200017,"level":"A2","pos":"other","en":"mess","fa":"به هم ریختگی، درهم و برهم","example":"My notebook is a mess; nothing is in order.","collocation":"a mess / be a mess","category":"داشتن دفترچه‌ی لغت"},{"id":200018,"level":"A2","pos":"other","en":"untidy","fa":"نامرتب","example":"Synonym for messy is untidy.","collocation":"an untidy room/notebook","category":"داشتن دفترچه‌ی لغت"},{"id":200019,"level":"A2","pos":"other","en":"forget","fa":"فراموش کردن","example":"I often forget to write down new words.","collocation":"forget to do something","category":"داشتن دفترچه‌ی لغت"},{"id":200020,"level":"A2","pos":"other","en":"explanation","fa":"توضیح","example":"Sometimes I write an explanation in English.","collocation":"write an explanation","category":"داشتن دفترچه‌ی لغت"},{"id":200021,"level":"A2","pos":"other","en":"tip","fa":"نکته، توصیه","example":"Here are some tips for your notebook.","collocation":"a useful tip","category":"داشتن دفترچه‌ی لغت"},{"id":200022,"level":"A2","pos":"other","en":"mix up","fa":"قاطی کردن، به هم ریختن","example":"Don't mix them up; put words from one topic together.","collocation":"mix up words","category":"داشتن دفترچه‌ی لغت"},{"id":200023,"level":"A2","pos":"other","en":"necessary","fa":"ضروری، لازم","example":"Write a translation if it is necessary.","collocation":"if necessary / not necessary","category":"داشتن دفترچه‌ی لغت"},{"id":200024,"level":"A2","pos":"other","en":"unnecessary","fa":"غیرضروری","example":"Translation is unnecessary if you can explain in English.","collocation":"unnecessary to do","category":"داشتن دفترچه‌ی لغت"},{"id":200025,"level":"A2","pos":"other","en":"enjoy","fa":"لذت بردن از","example":"I enjoy living in a big city.","collocation":"enjoy + -ing","category":"داشتن دفترچه‌ی لغت"},{"id":200026,"level":"A1","pos":"other","en":"bilingual dictionary","fa":"فرهنگ دو زبانه","example":"A bilingual dictionary is easy to understand.","collocation":"use a bilingual dictionary","category":"استفاده از فرهنگ لغت"},{"id":200027,"level":"A1","pos":"other","en":"look up","fa":"جستجو کردن (در لغت‌نامه)","example":"If you look up a word, you find it in a dictionary.","collocation":"look up a word","category":"استفاده از فرهنگ لغت"},{"id":200028,"level":"A1","pos":"other","en":"definition","fa":"تعریف","example":"A definition explains the meaning.","collocation":"the definition of a word","category":"استفاده از فرهنگ لغت"},{"id":200029,"level":"A1","pos":"other","en":"part of speech","fa":"نوع کلمه (اسم، فعل، ...)","example":"The dictionary shows the part of speech.","collocation":"part of speech is shown","category":"استفاده از فرهنگ لغت"}]